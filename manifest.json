{
  "manifest_version": 3,
  "name": "DeviceDeck",
  "version": "0.3.1",
  "description": "Preview any website at real device sizes, side by side. Open source, no account, no tracking.",
  "permissions": ["sidePanel", "tabs", "declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open DeviceDeck"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
